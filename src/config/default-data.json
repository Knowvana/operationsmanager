{
  "_schema": "DefaultData — Seed data written to Firestore during database initialization. Each key maps to a collection defined in database-schema.json. Documents are keyed by their document ID.",

  "system_admins": {
    "admin-default": {
      "email": "admin@knowvana.com",
      "displayName": "System Administrator",
      "password_plain": "admin123",
      "_note_password": "This plain text password is ONLY used to generate a bcrypt hash during seeding. It is NEVER written to the database.",
      "role": "system_admin",
      "permissions": ["platform.manage", "database.configure", "tenants.manage", "modules.manage"],
      "status": "active"
    }
  },

  "system_logs": {
    "log-seed-init": {
      "level": "info",
      "source": "System",
      "message": "Platform database initialized successfully",
      "user": "system",
      "result": "success",
      "data": null,
      "sessionId": "seed"
    }
  },

  "system_config": {
    "platform": {
      "configKey": "platform_metadata",
      "value": {
        "platformName": "Operations Manager",
        "version": "1.0.0",
        "databaseName": "knowvana"
      }
    },
    "logging": {
      "configKey": "logging_config",
      "value": {
        "minLevel": "debug",
        "maxBufferSize": 500,
        "consoleOutput": true,
        "captureApiCalls": true,
        "captureTimestamps": true,
        "flushIntervalSeconds": 60,
        "flushThreshold": 50,
        "persistLevels": ["warn", "error"]
      }
    }
  }
}
